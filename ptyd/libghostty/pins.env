# The exact sources of the screen emulator ptyd links statically. Read by build.sh; bump them only
# together, and only after the emulator's regression tests pass against the new pair.

# ghostty-org/ghostty: libghostty-vt is built from this commit, with patches/*.patch applied.
GHOSTTY_REPOSITORY=https://github.com/ghostty-org/ghostty.git
GHOSTTY_COMMIT=27e8b3fa85d9cf8c7cd5ae2ced348bcb0a4fba9c

# The Zig compiler that commit requires, with the SHA-256 ziglang.org publishes for each tarball.
ZIG_VERSION=0.16.0
ZIG_SHA256_x86_64=70e49664a74374b48b51e6f3fdfbf437f6395d42509050588bd49abe52ba3d00
ZIG_SHA256_aarch64=ea4b09bfb22ec6f6c6ceac57ab63efb6b46e17ab08d21f69f3a48b38e1534f17

# The Go bindings are pinned in ../go.mod and ../go.sum (go.mitchellh.com/libghostty at
# 31b65cdc24cfec370d313522ee3cb3dcb0ec48d3), which the Go toolchain verifies on its own.
