+test "Page VT keeps a row that only has background color" {
+    // A row erased with a colored pen has no text, only background color.
+    // It must not be treated as blank and dropped.
+    const testing = std.testing;
+    const alloc = testing.allocator;
+    const io = testing.io;
+
+    var builder: std.Io.Writer.Allocating = .init(alloc);
+    defer builder.deinit();
+
+    var t = try Terminal.init(io, alloc, .{ .cols = 10, .rows = 4 });
+    defer t.deinit(alloc);
+
+    var s = t.vtStream();
+    defer s.deinit();
+    s.nextSlice("top\r\n\x1b[44m\x1b[K\x1b[0m\r\nbottom");
+
+    const page = t.screens.active.pages.pages.last.?.page();
+    var formatter: PageFormatter = .init(page, .vt);
+    try formatter.format(&builder.writer);
+    const output = builder.writer.buffered();
+
+    // The middle row carries the blue background between the two text rows.
+    const first = std.mem.indexOf(u8, output, "\r\n") orelse return error.TestUnexpectedResult;
+    const last = std.mem.lastIndexOf(u8, output, "\r\n") orelse return error.TestUnexpectedResult;
+    try testing.expect(first != last);
+    const middle = output[first..last];
+    try testing.expect(std.mem.indexOf(u8, middle, "\x1b[44m") != null or
+        std.mem.indexOf(u8, middle, "\x1b[48;5;4m") != null);
+}
+
+test "Page VT writes blanks after a styled cell unstyled" {
+    // An inverse cell followed by blank cells and then text: the blanks
+    // must not be written while the inverse style is still active.
+    const testing = std.testing;
+    const alloc = testing.allocator;
+    const io = testing.io;
+
+    var builder: std.Io.Writer.Allocating = .init(alloc);
+    defer builder.deinit();
+
+    var t = try Terminal.init(io, alloc, .{ .cols = 20, .rows = 2 });
+    defer t.deinit(alloc);
+
+    var s = t.vtStream();
+    defer s.deinit();
+    s.nextSlice("\x1b[7m|\x1b[0m\x1b[1;10Hx");
+
+    const page = t.screens.active.pages.pages.last.?.page();
+    var formatter: PageFormatter = .init(page, .vt);
+    try formatter.format(&builder.writer);
+    const output = builder.writer.buffered();
+
+    // The reset comes before the run of blanks.
+    const bar = std.mem.indexOf(u8, output, "|") orelse return error.TestUnexpectedResult;
+    const blanks = std.mem.indexOf(u8, output, "        x") orelse return error.TestUnexpectedResult;
+    try testing.expect(std.mem.indexOf(u8, output[bar..blanks], "\x1b[0m") != null);
+}
