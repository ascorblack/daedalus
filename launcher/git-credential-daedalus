#!/bin/sh
# git credential helper: the organisation's token for its own repositories, the operator's for the rest.
# git feeds "protocol=…", "host=…", "path=owner/repo.git" on stdin; only the "get" action answers.
[ "$1" = "get" ] || exit 0
path=""
while IFS= read -r line; do
  case "$line" in
    path=*) path="${line#path=}" ;;
  esac
done
owner="${path%%/*}"
token="$GH_TOKEN"
if [ -n "$GH_ORG_TOKEN" ] && [ -n "$DAEDALUS_GITHUB_ORG" ] && [ "$owner" = "$DAEDALUS_GITHUB_ORG" ]; then
  token="$GH_ORG_TOKEN"
fi
[ -n "$token" ] || exit 0
echo "username=x-access-token"
echo "password=$token"
