# Copy to ../daedalus-secrets/keyproxy.env (OUTSIDE the repository; chmod 600). Only the key proxy reads it.
# Built-in upstreams: deepseek, openrouter, opencode (OpenCode Go, https://opencode.ai/go), openai.
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
OPENCODE_API_KEY=
OPENAI_API_KEY=
# Extra OpenAI-compatible upstreams reachable as http://keyproxy:3200/<name>:
#KEYPROXY_UPSTREAM_MYLLM=https://host/v1
#KEYPROXY_KEY_MYLLM=
# The proxy's own daily cap (USD), read from the agent's database; refuses model calls above it.
KEYPROXY_USD_PER_DAY=20
# Search APIs for the WebSearch tool (Settings → Tools → backend). The bot reaches them as http://keyproxy:3200/<name>/...;
# KEYPROXY_AUTH_<NAME> names the header the API takes its key in (default: Authorization: Bearer).
#KEYPROXY_UPSTREAM_SERPER=https://google.serper.dev
#KEYPROXY_KEY_SERPER=
#KEYPROXY_AUTH_SERPER=X-API-KEY
#KEYPROXY_UPSTREAM_KEENABLE=https://api.keenable.ai/v1
#KEYPROXY_KEY_KEENABLE=
#KEYPROXY_AUTH_KEENABLE=X-API-Key
#KEYPROXY_UPSTREAM_TAVILY=https://api.tavily.com
#KEYPROXY_KEY_TAVILY=
#KEYPROXY_UPSTREAM_EXA=https://api.exa.ai
#KEYPROXY_KEY_EXA=
#KEYPROXY_AUTH_EXA=x-api-key
#KEYPROXY_UPSTREAM_PERPLEXITY=https://api.perplexity.ai
#KEYPROXY_KEY_PERPLEXITY=
