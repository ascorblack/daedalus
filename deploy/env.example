# Copy to .env at the repository root. Never commit .env.

# Telegram bot token from @BotFather and your own numeric user id (the only user).
TELEGRAM_BOT_TOKEN=
OWNER_USER_ID=

# Local Bot API server (files up to 2 GB). Get these at https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Model providers. At least one key is required.
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
VLLM_BASE_URL=
VLLM_API_KEY=

# Fine-grained GitHub token limited to the two agent repositories (pull requests + contents).
GITHUB_TOKEN=

# Mini App URL (https, served by a reverse proxy in front of port 8765).
MINIAPP_PUBLIC_URL=

# Daily spend cap in USD, enforced by the supervisor (the agent cannot change it).
USD_PER_DAY=20

# Absolute paths on the host, used by the rebuilder container to rebuild the image when the Dockerfile changes.
DAEDALUS_COMPOSE_PROJECT_DIR=/absolute/path/to/daedalus
DAEDALUS_COMPOSE_FILE=/absolute/path/to/daedalus/deploy/compose.yaml
DAEDALUS_CORE_PROJECT_DIR=/absolute/path/to/protocore-exp
